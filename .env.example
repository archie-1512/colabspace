# Postgres connection string. Use Neon, Supabase, Railway, or local Postgres.
# Needs the pgvector extension (Neon, Supabase and Railway have it).
# On Neon in production, use the POOLED string here (host contains "-pooler",
# add &pgbouncer=true&connect_timeout=15) and the direct one as DIRECT_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/collabspace"

# Direct (non-pooled) connection, used only for migrations in Docker/production.
# Optional: if empty, DATABASE_URL is used.
DIRECT_URL=""

# Run `openssl rand -base64 32` to generate this
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Local dev: http://localhost:3000  |  Production: your deployed URL
NEXTAUTH_URL="http://localhost:3000"

# --- Optional: email invites ---
# If these are left blank, invite emails simply aren't sent — the app falls
# back to showing a copyable invite link in the UI instead. To actually send
# emails, fill these in. A Gmail "app password" or a free Resend SMTP
# account both work fine for a portfolio project:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- AI assistant (RAG) ---
# Embeddings run locally (all-MiniLM-L6-v2 via transformers.js) — free, no key.
# The model (~23MB) downloads automatically the first time something is indexed.
#
# Answers come from any OpenAI-compatible chat API. Groq's free tier is the default:
#   1. Get a free key at https://console.groq.com/keys
#   2. Paste it below. Leave LLM_BASE_URL / LLM_MODEL blank to use the defaults.
# If LLM_API_KEY is empty, "Ask workspace" still works: it shows the most
# relevant cards/files/DMs instead of a written answer.
# Defaults when left blank: base URL https://api.groq.com/openai/v1, model openai/gpt-oss-120b
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=""
#
# To use Google Gemini's free tier instead:
#   LLM_API_KEY="<key from https://aistudio.google.com/apikey>"
#   LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   LLM_MODEL="gemini-2.5-flash"

# --- File storage ---
# Leave empty to store uploads on local disk (development, docker compose).
# In production, set an S3 bucket name; the server's IAM role provides access.
S3_BUCKET=""
