# Copy to /opt/collabspace/config.env on the EC2 instance and fill in.
# Non-secret settings only. Secrets live in SSM Parameter Store under SSM_PATH.
AWS_REGION=ap-southeast-1
ECR_REPOSITORY_URI=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/collabspace
DOMAIN=collabspace.example.com
SSM_PATH=/collabspace/prod
